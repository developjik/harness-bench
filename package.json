{
  "name": "@developjik/harness-bench",
  "version": "0.1.0",
  "description": "Benchmark coding-agent harnesses on your own repository: mine test+impl commits, run each harness in an isolated git worktree, score the patches.",
  "keywords": [
    "benchmark",
    "coding-agent",
    "harness",
    "claude-code",
    "codex",
    "opencode",
    "damon",
    "evaluation"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "harness-bench": "dist/bin/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "node scripts/demo.mjs",
    "prepublishOnly": "npm run build",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/bin/cli.js', 0o755)\"",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developjik/harness-bench.git"
  }
}
